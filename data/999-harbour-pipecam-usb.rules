# Vendor-class device (0xff/0xf0): no uvcvideo, app opens the raw node via libusb.
# MODE=0666, not uaccess: logind resets uaccess ACLs on screen lock.
# Prefix must be 999-: 999-android-system.rules has a USB catch-all (0660 root:usb);
# a 99- file sorts before it and is overridden, last assignment wins.

# Geek szitman / supercamera
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2ce3", ATTR{idProduct}=="3828", MODE="0666"
# alternate ID pair
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0329", ATTR{idProduct}=="2022", MODE="0666"
