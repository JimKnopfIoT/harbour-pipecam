[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-pipecam
Name=PipeCam
Comment=USB pipe inspection camera
Comment[de]=USB-Rohrkamera
Exec=harbour-pipecam

[X-Sailjail]
# Required: default sailjail profile applies PID ns/NoNewPrivs/seccomp,
# no permission grants raw USB; diagnostics need real /proc and system bus.
Sandboxing=Disabled
