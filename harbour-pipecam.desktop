[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-pipecam
Name=PipeCam
Comment=USB pipe inspection camera
Comment[de]=USB-Rohrkamera
Exec=harbour-pipecam

[X-Sailjail]
# Sandboxing=Disabled — deliberate, and it has to be spelled out.
#
# The app opens the camera's raw USB node under /dev/bus/usb/ via libusb (the
# device is vendor-class, so there is no /dev/videoN to request a Camera
# permission for), and there is no stock Sailjail permission that grants raw
# USB access.
#
# Leaving the section out does NOT mean "unsandboxed": with sailjail's Default
# Profile enabled (Sailfish OS 5.x), an app without a section is started in the
# default sandbox — own PID namespace, NoNewPrivs, seccomp — as `invoker` says
# in the journal ("enforcing sandboxing"). Measured on the test phone in 0.1.2.
# The diagnostic report also needs the real /proc (which process holds the
# camera, whether Android App Support runs) and the system bus to start its
# optional helper. Same choice as harbour-sflipper and harbour-sysmetrics.
#
# The trade-off is accepted knowingly: the app has no network code at all,
# reads nothing but the camera and its own diagnostics, and writes only into
# ~/Pictures/pipecam, ~/Documents (reports, on request) and its cache.
Sandboxing=Disabled
